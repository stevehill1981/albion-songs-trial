---
import VisualEditor from '../components/editor/VisualEditor.astro';
import {loadContent} from '../lib/content.mjs';
import {EDITOR_PAGES} from '../lib/editor-pages.mjs';
import {validateComponentPage} from '../lib/component-preview.mjs';
import site from '../../site.json';
import page from '../../content/pages/component-preview-trial.json';
const context=await loadContent();
const pages=EDITOR_PAGES.map(id=>{const page=context.pages.find(page=>page.slug===id);validateComponentPage(page);return {id,title:page.title};});
---
<VisualEditor page={page} context={context} site={site} pages={pages} workflow/>
