---
import {loadContent,publicPage} from '../../lib/content.mjs';
import ComponentPage from '../../components/ComponentPage.astro';
import {supportsAstroPage} from '../../lib/component-preview.mjs';
import version from '../../../public/version.json';
export async function getStaticPaths(){const content=await loadContent();return content.templates.map(page=>({params:{slug:page.slug},props:{page,content}}));}
const {page,content}=Astro.props;
const native=supportsAstroPage(page);
const html=native?null:publicPage(content,page,version.revision);
---
<Fragment>{native?<ComponentPage page={page} content={content} revision={version.revision}/>:<Fragment set:html={html}/>}</Fragment>
