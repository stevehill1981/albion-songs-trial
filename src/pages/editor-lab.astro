---
import VisualEditor from '../components/editor/VisualEditor.astro';
import {loadContent} from '../lib/content.mjs';
import site from '../../site.json';
import source from '../../content/pages/manager-darren-moore.json';
const context=await loadContent();
const page=structuredClone(source);
const photograph=Object.keys(context.photographs)[0];
page.blocks.push({type:'section',anchor:'layout-practice',heading:'Try a different layout',background:'pale-blue',spacing:'standard',columns:[{blocks:[{type:'text-panel',anchor:'practice-text',heading:'A space for the next story',navLabel:'',paragraphs:[{parts:[{type:'text',text:'This extra section belongs only to the practice copy. Try its background and spacing, or choose a different credited photograph.'}]}],sources:[]}]},{blocks:[{type:'photograph',anchor:'practice-photo',heading:'From the photograph library',navLabel:'',photograph}]}]});
---
<VisualEditor page={page} context={context} site={site}/>
