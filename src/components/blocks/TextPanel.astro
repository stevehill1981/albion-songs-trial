---
import {renderParts} from '../../lib/inline-parts.mjs';
import {headingHTML} from '../../lib/component-preview.mjs';
const {block:b}=Astro.props;
---
<section class="wrap section" id={b.anchor}><h2 set:html={headingHTML(b.heading)}/>{b.paragraphs.map(p=><p set:html={renderParts(p.parts)}/>)}{b.sources.map((s,i)=><Fragment>{i>0?' · ':''}<a href={s.url}>{s.label}</a></Fragment>)}</section>
