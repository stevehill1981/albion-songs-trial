---
import {performanceView,performanceColumns,performanceValue,performanceScope,performanceSemantics,performanceDate} from '../../lib/manager-performance.mjs';
import {headingHTML} from '../../lib/component-preview.mjs';
const {block:b,context}=Astro.props;
const view=performanceView(b,context);
---
<section class="wrap section manager-performance" id={b.anchor} aria-labelledby={`${b.anchor}-title`} data-archive-sha={view.sourceSha256}><h2 id={`${b.anchor}-title`} set:html={headingHTML(b.heading)}/><p>{performanceScope}</p>{view.profile.researchNotes.map(note=><p class="manager-performance-warning"><strong>Open research question.</strong> {note}</p>)}<div class="manager-performance-scroll" role="region" aria-label={`${view.profile.name} recorded performance`} tabindex="0"><table><caption>{view.profile.name} · recorded results by spell</caption><thead><tr><th scope="col">Spell</th>{performanceColumns.map(([,label])=><th scope="col">{label}</th>)}</tr></thead><tbody>{view.rows.map(row=><tr><th scope="row">{row.label}</th>{performanceColumns.map(([key])=><td>{performanceValue(row.summary,key)}</td>)}</tr>)}</tbody></table></div><p>{performanceSemantics}</p><p>{view.evidence}</p><p>Archive checked: {view.checked}. <a href="/data/results.json">Match records and source credits</a>.</p><details><summary>Match boundaries and sources</summary>{view.tenures.map(t=><Fragment><h3>{t.role==='caretaker'?'Caretaker':'Permanent'} · {performanceDate(t.firstMatchDate)} – {performanceDate(t.lastMatchDate)}</h3><p>{t.note}</p><p>Boundary evidence: {t.evidenceStatus}.</p><ul>{t.sources.map(s=><li><a href={s.url}>{s.label}</a></li>)}</ul></Fragment>)}</details></section>
