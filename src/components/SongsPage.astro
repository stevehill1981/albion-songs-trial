---
import template from '../../legacy/songs.html?raw';
import fact from '../../content/fact.json';
import version from '../../public/version.json';
import { renderFact } from '../lib/fact.mjs';
const html = template.replace('<!-- EDITABLE_FACT -->', renderFact(fact)).replace('</head>', `<meta name="trial-revision" content="${version.revision}"></head>`);
---
<Fragment set:html={html} />
