---
import BlockList from '../blocks/BlockList.astro';
const {page,context,site,workflow=false}=Astro.props;
const data=JSON.stringify({page,workflow,origin:site.origin,authOrigin:site.authOrigin,photographs:Object.entries(context.photographs).map(([id,p])=>({id,caption:p.caption,author:p.author}))}).replaceAll('<','\u003c');
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>Visual editor · Throstle &amp; Stripes</title></head><body>
<a class="skip" href="#block-fields">Skip to editing controls</a>
<header class="lab-top"><div><strong>Throstle &amp; Stripes</strong><span>{workflow?'Page editor · practice page':'Visual editor · practice copy'}</span></div><div class="actions"><button id="undo" disabled>Undo</button><button id="redo" disabled>Redo</button><button id="reset">{workflow?'Undo unsaved changes':'Reset practice copy'}</button><a href="/admin/">Normal editor</a></div></header>
<p class="lab-notice" hidden={workflow}>Explore a copy of Darren Moore’s profile. Nothing here saves or publishes to the museum. Select a block, then use its fields or choose “Type on page”.</p>
{workflow&&<section class="save-bar" aria-label="Save and publish"><div><strong>Build a page with Marie</strong><p id="workflow-status" role="status">Connect GitHub to load the saved page.</p></div><div class="actions"><button id="save-draft" disabled>Save draft</button><button id="open-drafts" disabled>Open saved drafts</button><button id="check-draft" disabled>Check saved version</button><a id="saved-preview" hidden target="_blank" rel="noopener noreferrer">Open checked preview</a><button id="publish-draft" disabled>Publish this version</button><a id="public-page" href="/component-preview-trial" target="_blank" rel="noopener noreferrer">View public page</a></div><div id="saved-drafts" hidden><h2>Saved drafts</h2><button id="open-published">Open published version</button><div id="draft-list"></div><button id="more-drafts" hidden>Next list page</button></div><p class="small-note">Save a draft, open its checked full-page preview, then publish. Typing here never changes the public site.</p></section>}
<div class="lab-workspace"><aside class="lab-outline" aria-label="Page content"><h1>{workflow?'Page content':'Darren Moore'}</h1><p>Page outline</p><nav id="outline" aria-label="Choose a block"></nav></aside>
<main class="lab-canvas"><div class="lab-toolbar"><fieldset><legend>Preview width</legend><button id="desktop" aria-pressed="true">Desktop</button><button id="phone" aria-pressed="false">Phone</button></fieldset><button id="sign-in">{workflow?'Connect GitHub to edit':'Connect GitHub for live preview'}</button><button id="sign-out" hidden>Disconnect</button></div><p id="preview-status" role="status">Loading the Astro-rendered practice copy…</p><div id="preview-viewport"><iframe id="canvas" title="Editable Astro page preview" sandbox="allow-same-origin" referrerpolicy="no-referrer"></iframe></div></main>
<aside class="lab-fields" id="block-fields" tabindex="-1"><h2 id="selected-title">Page introduction</h2><p id="field-help">Select a block in the page or its outline.</p><form id="fields" onsubmit="return false" inert={workflow}></form><p id="draft-status" role="status">{workflow?'Connect GitHub to start editing':'Original practice copy'}</p><p class="small-note">Source links, photo credits and calculated results stay attached. This prototype edits simple text only.</p></aside></div>
<template id="initial-render"><BlockList page={page} context={context}/></template>
<script id="visual-data" type="application/json" set:html={data}/>
<script>import '../../editor/visual/index.mjs';</script>
</body></html>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#142647;background:#eef2f7;font-synthesis:none;--navy:#142647;--line:#c2ccd9}*{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}button,a,input,textarea,select{touch-action:manipulation}button{border:1px solid #788aa3;border-radius:5px;background:white;color:var(--navy);padding:.6rem .8rem;cursor:pointer;min-height:42px}button:hover{background:#e6edf7}button:disabled{cursor:default;opacity:.5}a{color:inherit;text-underline-offset:3px}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:3px solid #b55b00;outline-offset:3px}::selection{background:#ccdcf5;color:#142647}.skip{position:absolute;top:-100px}.skip:focus{top:8px;left:8px;z-index:5;background:white;padding:1rem}.lab-top{background:var(--navy);color:white;padding:1rem 1.5rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}.lab-top strong{font:700 1.35rem Georgia,serif;display:block}.lab-top span{display:block;margin-top:.4rem;font-size:.85rem;color:#dbe5f4}.actions{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}.actions a{padding:.5rem}.lab-notice{margin:0;padding:1rem 1.5rem;background:#fff;color:#344968;border-bottom:1px solid var(--line);font-size:.9rem;line-height:1.5}.lab-workspace{display:grid;grid-template-columns:210px minmax(360px,1fr) 290px;min-height:calc(100vh - 160px)}.lab-outline,.lab-fields{background:white;padding:1.4rem 1rem}.lab-outline{border-right:1px solid var(--line)}.lab-fields{border-left:1px solid var(--line)}.lab-outline h1{font:700 1.4rem Georgia,serif;margin:0 0 .6rem}.lab-outline p,.small-note,#field-help{font-size:.85rem;line-height:1.5;color:#405575}.lab-outline nav{display:grid;gap:.4rem;margin-top:1rem}.lab-outline button{text-align:left;line-height:1.4;width:100%}.lab-outline button[data-child]{padding-left:1.4rem;font-size:.85rem}.lab-outline button[aria-current="true"]{background:#142647;color:white}.lab-canvas{min-width:0;padding:1rem}.lab-toolbar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap}.lab-toolbar fieldset{border:0;padding:0;margin:0;display:flex;gap:.35rem}.lab-toolbar legend{font-size:.8rem;margin-bottom:.4rem}.lab-toolbar [aria-pressed="true"]{background:var(--navy);color:white}#preview-status{font-size:.85rem;line-height:1.5;min-height:2.6rem;color:#344968}#preview-viewport{width:100%;margin:auto;max-width:100%;background:white;border:1px solid var(--line)}#preview-viewport.phone{width:390px}#canvas{display:block;width:100%;height:75vh;min-height:500px;border:0}.lab-fields h2{font-size:1.15rem;margin:0 0 .8rem;line-height:1.4}#fields label{display:block;font-weight:700;font-size:.85rem;margin-top:1.2rem}#fields textarea,#fields select{width:100%;padding:.7rem;margin-top:.4rem;border:1px solid #788aa3;border-radius:4px;background:white;color:#142647;line-height:1.5}#fields textarea{resize:vertical;min-height:90px;caret-color:#142647}#fields button{margin-top:.5rem}#draft-status{font-size:.85rem;padding-top:1rem;border-top:1px solid var(--line);margin-top:1.5rem;line-height:1.5}[hidden]{display:none!important}.save-bar{padding:1rem 1.5rem;background:white;border-bottom:1px solid var(--line)}.save-bar>div:first-child{display:flex;align-items:baseline;flex-wrap:wrap;gap:.4rem 1.5rem}.save-bar p{line-height:1.5;font-size:.9rem;margin:.5rem 0}.save-bar .actions{margin:.75rem 0}#save-draft,#publish-draft{background:var(--navy);color:white}#save-draft:hover,#publish-draft:hover{background:#29466e}#draft-list{display:grid;gap:.5rem;margin:.75rem 0}#draft-list button{text-align:left}#saved-drafts{border-top:1px solid var(--line);margin-top:1rem;padding-top:.5rem}#saved-drafts h2{font-size:1rem}@media(max-width:1100px){.lab-workspace{grid-template-columns:170px minmax(300px,1fr)}.lab-fields{grid-column:1/-1;border-left:0;border-top:1px solid var(--line)}#fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0 1.5rem}}@media(max-width:620px){.lab-top{padding:1rem}.lab-workspace{display:block}.lab-outline{border-right:0;border-bottom:1px solid var(--line)}.lab-outline nav{grid-template-columns:repeat(2,minmax(0,1fr))}.lab-canvas{padding:.75rem}.lab-notice{padding:1rem}.lab-toolbar button{font-size:.8rem}#canvas{height:65vh;min-height:400px}}
</style>
