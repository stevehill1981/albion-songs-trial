      "paragraphs": [
        {
          "parts": [
            {
              "type": "text",
              "text": "Albion announced his return on 17 January 2025, but Chris Brunt still took the Stoke match the following day. Mowbray’s first match back was at Middlesbrough on 21 January."
            }
